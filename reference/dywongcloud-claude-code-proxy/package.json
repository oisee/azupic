{
  "name": "claude-code-proxy-openai-moonshot",
  "version": "1.0.1",
  "description": "Anthropic-compatible local proxy for Claude Code using OpenAI Platform and Moonshot/Kimi API keys",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "claude-code-proxy": "./bin/claude-code-proxy.js"
  },
  "scripts": {
    "start": "node ./bin/claude-code-proxy.js serve",
    "test": "node --test --test-reporter=spec",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "node ./scripts/check.mjs",
    "smoke": "node ./bin/claude-code-proxy.js models"
  },
  "keywords": [
    "claude-code",
    "openai",
    "moonshot",
    "kimi-k3",
    "anthropic",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/raine/claude-code-proxy"
  }
}

