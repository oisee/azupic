# Use either the CCP-prefixed variable or the provider-native variable.
CCP_OPENAI_API_KEY=
# OPENAI_API_KEY=

CCP_MOONSHOT_API_KEY=
# MOONSHOT_API_KEY=

# Optional overrides
CCP_OPENAI_BASE_URL=https://api.openai.com/v1
CCP_MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
CCP_OPENAI_DEFAULT_MODEL=gpt-5.6-sol
CCP_MOONSHOT_DEFAULT_MODEL=kimi-k3
CCP_OPENAI_ENCRYPTED_REASONING=1
PORT=18765

# Compatibility only: first-party Moonshot K3 supports system-role messages.
# Set to 1 only when using a third-party gateway that rejects them.
CCP_MOONSHOT_MERGE_SYSTEM=0

# Browser CORS is closed by default. Enabling one origin also requires
# CCP_PROXY_AUTH_TOKEN. Claude Code CLI does not need this.
# CCP_CORS_ORIGIN=https://trusted.example

